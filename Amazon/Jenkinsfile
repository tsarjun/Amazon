pipeline {
    agent any

    stages {
        stage('clone project') {
            steps {
                git branch: 'master', url: 'https://github.com/tsarjun/Amazon.git'
            }
        }


        stage('clean') {
            steps {
                dir('Amazon/Amazon-web') {   // <-- folder containing pom.xml
                    sh 'mvn clean'
                }
            }
        }

        stage('compile') {
            steps {
                dir('Amazon/Amazon-web') {
                    sh 'mvn compile'
                }
            }
        }

        stage('test') {
            steps {
                dir('Amazon/Amazon-web') {
                    sh 'mvn test'
                }
            }
        }

        stage('build') {
            steps {
                dir('Amazon/Amazon-web') {
                    sh 'mvn clean install'
                }
            }
        }
    } // closes stages
} // closes pipeline
