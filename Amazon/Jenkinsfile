pipeline {
    agent any

    stages {
        stage('clone project') {
            steps {
                git branch: 'master', url: 'https://github.com/tsarjun/Amazon.git'
            }
        }

        stage('clean') {
            steps {
                dir('Amazon/Amazon') {        // <-- go to the folder with pom.xml
                    sh 'mvn clean'
                }
            }
        }
  stage('List files') {
            steps {
                sh 'ls -R'
            }
        }
        
        // Maven stages will go here
    }
}        
       stage('compile') {
            steps {
                dir('Amazon/Amazon') {
                    sh 'mvn compile'
                }
            }
        }

        stage('test') {
            steps {
                dir('Amazon/Amazon') {
                    sh 'mvn test'
                }
            }
        }

        stage('build') {
            steps {
                dir('Amazon/Amazon') {
                    sh 'mvn clean install'
                }
            }
        }

    } // closes stages
} // closes pipeline
